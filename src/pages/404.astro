---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found — Salmon Software">
  <article class="not-found">
    <h1>Salmon Software</h1>
    <p>Page not found.</p>
    <p><a href="/">Return home</a></p>
  </article>
</BaseLayout>

<style>
  .not-found {
    width: min(600px, calc(100% - 40px));
    margin: 0 auto;
    padding: 64px 0 48px;
  }

  h1,
  p {
    margin: 0 0 16px;
  }

  h1 {
    font-size: 15px;
    line-height: 1.55;
    font-weight: 600;
  }
</style>
