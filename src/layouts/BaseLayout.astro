---
import SEOHead from '@/components/layout/SEOHead.astro';
import '@/styles/global.css';
interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  type?: 'website' | 'article';
}

const { title, description, ogImage, type } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <SEOHead title={title} description={description} ogImage={ogImage} type={type} />
    <link rel="preload" href="/fonts/Newsreader-Italic.woff2" as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a
      href="#main-content"
      class="skip-link"
    >
      Skip to content
    </a>
    <main id="main-content">
      <slot />
    </main>
  </body>
</html>
